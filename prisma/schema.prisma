// Prisma Schema for Church Management System
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PASTOR
  COORDINADOR
  SECRETARIA
  LEADER
  MULTIMEDIA
  MULTIMEDIA_LEADER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum BaptismStatus {
  BAPTIZED
  PENDING
  NOT_BAPTIZED
}

enum FollowUpStatus {
  ATTENTION_REQUIRED // Red
  WARNING            // Yellow
  UP_TO_DATE         // Green
}

enum EventType {
  SERVICE
  MINISTRY
  TEACHING
  OUTREACH
}

enum TicketCategory {
  WORSHIP_SONG // Alabanzas y letras para proyectar
  MEDIA_REQUEST // Publicidades
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id                 String     @id @default(uuid())
  username           String     @unique
  email              String?
  passwordHash       String
  name               String
  role               Role       @default(LEADER)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime       @updatedAt
  followUps          FollowUp[]     @relation("ConsolidatorFollowUps")
  notifications      Notification[] @relation("UserNotifications")
}

model Member {
  id            String        @id @default(uuid())
  fullName      String
  identityCard  String?       @unique
  phone         String?
  email         String?
  ministry      String?
  baptismStatus BaptismStatus @default(PENDING)
  status        MemberStatus  @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  followUps     FollowUp[]
}

model Ministry {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  leaderName  String?
  createdAt   DateTime @default(now())
}

model FollowUp {
  id             String         @id @default(uuid())
  memberId       String
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  consolidatorId String?
  consolidator   User?          @relation("ConsolidatorFollowUps", fields: [consolidatorId], references: [id])
  status         FollowUpStatus @default(WARNING)
  notes          String?
  lastContactAt  DateTime       @default(now())
  nextContactAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Event {
  id        String          @id @default(uuid())
  title     String
  date      DateTime
  location  String
  type      EventType       @default(SERVICE)
  createdAt DateTime        @default(now())
  reminders EventReminder[]
}

model MultimediaTicket {
  id          String         @id @default(uuid())
  title       String
  category    TicketCategory @default(WORSHIP_SONG)
  description String?
  requestedBy String
  assignedTo  String?
  status      TicketStatus   @default(PENDING)
  eventDate   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Verse {
  id        String   @id @default(uuid())
  text      String
  reference String
  createdAt DateTime @default(now())
}

model EventReminder {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type         String   // e.g. "1_HOUR", "1_DAY", "1_WEEK"
  scheduledFor DateTime
  status       String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
