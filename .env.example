# Database Connection Strings (PostgreSQL / Supabase)
# Transaction pooler (for serverless runtime & App Router API routes)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session direct connection (used for Prisma migrations and CLI seeds)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Next.js Environment Setup
NODE_ENV="development"
